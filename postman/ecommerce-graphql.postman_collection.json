    {
      "name": "2. Mutations",
      "item": [
        {
          "name": "M1 - Create Order (happy path)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation PlaceOrder($input: CreateOrderInput!) {\n  createOrder(input: $input) {\n    id\n    status\n    totalAmount\n    createdAt\n    items {\n      quantity\n      unitPrice\n      subtotal\n      product { name }\n    }\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"userId\": 2,\n    \"items\": [\n      {\n        \"productId\": 1,\n        \"quantity\": 1\n      },\n      {\n        \"productId\": 4,\n        \"quantity\": 2\n      }\n    ]\n  }\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"No GraphQL errors\", function () {",
                  "    pm.expect(json.errors).to.be.undefined;",
                  "});",
                  "pm.test(\"Order created with status PENDING\", function () {",
                  "    pm.expect(json.data.createOrder.status).to.eql(\"PENDING\");",
                  "});",
                  "pm.test(\"Total amount is greater than 0\", function () {",
                  "    pm.expect(parseFloat(json.data.createOrder.totalAmount)).to.be.greaterThan(0);",
                  "});",
                  "if (json.data && json.data.createOrder) {",
                  "    pm.collectionVariables.set(\"lastCreatedOrderId\", json.data.createOrder.id);",
                  "}"
                ]
              }
            }
          ]
        },
