{
  "info": {
    "name": "Ecommerce GraphQL - Order Management",
    "description": "Postman collection for the Spring Boot 3 + Spring GraphQL Order Management demo. Covers queries, mutations, N+1 batch-loading verification, and negative/error-handling test cases. Subscriptions are NOT included here (Postman's WebSocket/GraphQL-subscription support varies by version) \u2014 use GraphiQL or wscat as described in TESTING_GUIDE.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "lastCreatedOrderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "lastCreatedUserId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Queries",
      "item": [
        {
          "name": "Q1 - Get User By Id (deep nested User -> Orders -> Items -> Product)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query DeepUserGraph {\n  getUserById(id: 1) {\n    id\n    name\n    email\n    orders {\n      id\n      status\n      totalAmount\n      createdAt\n      items {\n        id\n        quantity\n        unitPrice\n        subtotal\n        product {\n          id\n          name\n          price\n        }\n      }\n    }\n  }\n}",
                "variables": "{}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"No GraphQL errors\", function () {",
                  "    pm.expect(json.errors).to.be.undefined;",
                  "});",
                  "pm.test(\"User name is present\", function () {",
                  "    pm.expect(json.data.getUserById.name).to.eql(\"Alice Johnson\");",
                  "});",
                  "pm.test(\"Nested orders array is present\", function () {",
                  "    pm.expect(json.data.getUserById.orders).to.be.an(\"array\");",
                  "    pm.expect(json.data.getUserById.orders.length).to.be.greaterThan(0);",
                  "});",
                  "pm.test(\"Nested product graph resolved\", function () {",
                  "    pm.expect(json.data.getUserById.orders[0].items[0].product.name).to.exist;",
                  "});"
                ]
              }
            }
          ]
        },
