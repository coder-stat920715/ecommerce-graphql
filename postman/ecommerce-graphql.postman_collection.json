                  "    pm.expect(json.errors).to.be.an(\"array\").with.lengthOf(1);",
                  "});",
                  "pm.test(\"Error is classified as BAD_REQUEST (validation)\", function () {",
                  "    pm.expect(json.errors[0].extensions.errorCode).to.eql(\"BAD_REQUEST\");",
                  "});",
                  "pm.test(\"Error message mentions quantity\", function () {",
                  "    pm.expect(json.errors[0].message.toLowerCase()).to.include(\"quantity\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
