                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"Response contains exactly one error\", function () {",
                  "    pm.expect(json.errors).to.be.an(\"array\").with.lengthOf(1);",
                  "});",
                  "pm.test(\"Error is classified as BAD_REQUEST\", function () {",
                  "    pm.expect(json.errors[0].extensions.errorCode).to.eql(\"BAD_REQUEST\");",
                  "});",
                  "pm.test(\"Error extensions include stock details\", function () {",
                  "    pm.expect(json.errors[0].extensions.requestedQuantity).to.exist;",
                  "    pm.expect(json.errors[0].extensions.availableQuantity).to.exist;",
                  "});"
                ]
              }
            }
